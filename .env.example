# Server only. Copy to .env.development or .env.production; never commit secrets.
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
OPENAI_API_KEY=
# Verified in official model documentation; deployment must verify account access.
OPENAI_MODEL=gpt-4.1-mini
# 'none' omits the reasoning parameter, for compatibility with non-reasoning models.
OPENAI_REASONING_EFFORT=none
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
AI_REQUESTS_PER_MINUTE=60
AI_REQUESTS_PER_DAY=5000
AI_MONTHLY_TOKEN_LIMIT=10000000
AI_MAX_OUTPUT_TOKENS=1200
AI_MODEL_PRICING={"gpt-4.1-mini":{"input":0.4,"cachedInput":0.1,"output":1.6}}
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SERVER_SUPABASE_SECRET_KEY=
DATABASE_URL=
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
# 32 random bytes in base64; encrypts connected account tokens at rest.
TOKEN_ENCRYPTION_KEY=
WEBHOOK_BASE_URL=
NGROK_AUTH_TOKEN=
# Frontend public configuration only. Required for the live login screen.
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
